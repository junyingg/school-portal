{
  "name": "@school-portal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx --conditions=source --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@school-portal/contract": "workspace:*",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "kysely": "0.29.9",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.2",
    "@types/pg": "8.23.1",
    "testcontainers": "12.2.2",
    "tsx": "4.23.15"
  }
}
