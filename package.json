{
  "name": "school-portal",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.21.0 <13"
  },
  "scripts": {
    "env:init": "node scripts/initEnv.ts",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:component",
    "test:unit": "vitest run --project \"unit:*\"",
    "test:component": "vitest run --project component:web",
    "test:coverage": "vitest run --project \"unit:*\" --project component:web --coverage",
    "test:integration": "vitest run --project integration:api",
    "db:migrate": "pnpm -F @school-portal/api db:migrate",
    "openapi:write": "pnpm -F @school-portal/api openapi:write",
    "stack:up": "docker compose up --build --wait",
    "stack:down": "docker compose down -v",
    "test:contract": "pnpm -F @school-portal/postman-tests test:contract",
    "postman:sync": "pnpm -F @school-portal/postman-tests sync",
    "test:e2e": "pnpm -F @school-portal/e2e test",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "audit:all": "pnpm audit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
