        {
          "name": "POST Mary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"matches teacherSchema\", () => pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"teacherSchema\"))));",
                  "pm.test(\"returns the teacher as sent\", () => {",
                  "  pm.expect(pm.response.json()).to.eql({ name: \"Mary\", subject: \"Mathematics\", email: pm.collectionVariables.get(\"maryEmail\"), contactNumber: \"68129414\" });",
                  "});",
                  "pm.test(\"the teacher schema rejects an extra key\", () => {",
                  "  pm.expect({ ...pm.response.json(), id: 1 }).to.not.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"teacherSchema\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teachers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Mary\",\"subject\":\"Mathematics\",\"email\":\"{{maryEmail}}\",\"contactNumber\":\"68129414\"}"
            }
          }
        },
        {
          "name": "POST Ken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"status is 201\", () => pm.response.to.have.status(201));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teachers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Ken\",\"subject\":\"Mother Tongue Language\",\"email\":\"{{kenEmail}}\",\"contactNumber\":\"61824191\"}"
            }
