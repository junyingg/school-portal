{
  "info": {
    "name": "School Portal API",
    "description": "Black-box contract tests for the four School Portal endpoints, run through nginx.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"runId\")) {",
          "  pm.collectionVariables.set(\"runId\", `${Date.now()}${Math.floor(Math.random() * 1000)}`);",
          "}",
          "const runId = pm.collectionVariables.get(\"runId\");",
          "pm.collectionVariables.set(\"maryEmail\", `mary.${runId}@example.com`);",
          "pm.collectionVariables.set(\"maryEmailUpperCase\", `MARY.${runId}@EXAMPLE.COM`);",
          "pm.collectionVariables.set(\"kenEmail\", `ken.${runId}@example.com`);",
          "pm.collectionVariables.set(\"otherEmail\", `other.${runId}@example.com`);",
          "pm.collectionVariables.set(\"nobodyEmail\", `nobody.${runId}@example.com`);",
          "pm.collectionVariables.set(\"className\", `Class ${runId}A`);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"responds with UTF-8 JSON\", () => {",
          "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"application/json; charset=utf-8\");",
          "});",
          "pm.test(\"exposes no internal fields\", () => {",
          "  const text = pm.response.text();",
          "  pm.expect(text).to.not.include('\"id\"');",
          "  pm.expect(text).to.not.include(\"createdAt\");",
          "});",
          "if (pm.response.code >= 400) {",
          "  pm.test(\"matches errorSchema\", () => {",
          "    pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"errorSchema\")));",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Smoke",
      "item": [
        {
          "name": "GET /api/teachers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"matches teacherListSchema\", () => pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"teacherListSchema\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teachers"]
            }
          }
        }
      ]
    },
    {
