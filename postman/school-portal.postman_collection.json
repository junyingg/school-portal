              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teachers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Other\",\"subject\":\"Science\",\"email\":\"{{otherEmail}}\",\"contactNumber\":\"91234567\"}"
            }
          }
        },
        {
          "name": "GET list",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"matches teacherListSchema\", () => pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"teacherListSchema\"))));",
                  "const emails = pm.response.json().data.map((teacher) => teacher.email);",
                  "pm.test(\"lists Mary before Ken\", () => {",
                  "  pm.expect(emails.indexOf(pm.collectionVariables.get(\"maryEmail\"))).to.be.below(emails.indexOf(pm.collectionVariables.get(\"kenEmail\")));",
                  "  pm.expect(emails.indexOf(pm.collectionVariables.get(\"maryEmail\"))).to.be.at.least(0);",
                  "});",
                  "pm.test(\"each teacher has exactly four keys\", () => {",
                  "  pm.response.json().data.forEach((teacher) => pm.expect(Object.keys(teacher)).to.have.lengthOf(4));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teachers"]
            }
          }
        }
      ]
    },
